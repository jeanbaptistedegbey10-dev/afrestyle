# ─────────────────────────────────────────────────────────────────────────────
#  AfroStyle — modèle de variables d'environnement
#  Copier en `.env.local` puis renseigner les valeurs.
#  ⚠️ Aucun secret ne doit être committé : `.env*` est ignoré par git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Shopify : boutique ──────────────────────────────────────────────────────
# Accepte "afrestyle-dev" ou "afrestyle-dev.myshopify.com" (normalisé par
# src/lib/shopify/version.ts).
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=afrestyle-dev.myshopify.com

# ── Shopify : Storefront API (lectures publiques) ───────────────────────────
# Client : src/lib/shopify/storefrontClient.ts
# Endpoint : https://<domaine>/api/2026-07/graphql.json
NEXT_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# ── Shopify : Admin API (SERVEUR UNIQUEMENT) ────────────────────────────────
# Client : src/lib/shopify/adminClient.ts (création/maj produits, publication)
# Endpoint : https://<domaine>/admin/api/2026-07/graphql.json
# Scopes requis : write_products, read_publications, write_publications
# ⚠️ JAMAIS de préfixe NEXT_PUBLIC_ sur cette variable (fuite du token).
# Obtenir le token : Shopify Admin → Paramètres → Applications et canaux de
# vente → Développer des applications → <votre app> → Jetons d'accès à l'API
# d'administration → « Installer » puis copier le jeton (préfixe `shpat_…`).
# Le jeton ne s'affiche qu'UNE fois : stockez-le aussitôt dans `.env.local`.
# ⚠️ Ne JAMAIS l'écrire en dur (code, scripts/, docs) — uniquement `process.env`.
# Si un jeton a fuité (ex. ancien scripts/*.mjs) : révoquez-le dans l'admin
# Shopify (rotation de clé) et régénérez-en un nouveau.
SHOPIFY_ADMIN_ACCESS_TOKEN=

# ── Shopify : optionnel ─────────────────────────────────────────────────────
# ID (`gid://shopify/Publication/…`) de la publication « Online Store ».
# Optionnel : résolu automatiquement via la requête `publications` si vide.
SHOPIFY_ONLINE_STORE_PUBLICATION_ID=

# ── Shopify : Webhooks (SERVEUR UNIQUEMENT — Phase 6) ────────────────────────
# Vérifié par src/app/api/revalidate/route.ts (HMAC-SHA256 du corps brut,
# header `x-shopify-hmac-sha256`).
# Obtenir le secret : Shopify Admin → Paramètres → Notifications → Webhooks →
# créer les webhooks products/create, products/update, products/delete,
# collections/create, collections/update, collections/delete vers
# https://<domaine-prod>/api/revalidate → copier le « secret » affiché.
# ⚠️ JAMAIS de préfixe NEXT_PUBLIC_ (sinon le secret fuite dans le bundle).
# Génération locale (si webhook custom) :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex)')"
#   openssl rand -hex 32
SHOPIFY_WEBHOOK_SECRET=

# ── Application ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Back-office admin ───────────────────────────────────────────────────────
# Login du panneau /admin (formulaire /admin/login).
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Secret de session admin — OBLIGATOIRE (vérifié par src/middleware.ts,
# assertAdmin() dans src/lib/actions/admin.actions.ts, et les routes dev/test
# /api/seed/* + /api/test-shopify via le header `x-admin-secret`).
#
# Rôle : valeur posée dans le cookie httpOnly `admin_token` au login réussi,
# puis comparée (temps constant) à chaque accès /admin/*. Il doit être :
#   • aléatoire (32 octets / 64 caractères hex minimum),
#   • DISTINCT du mot de passe ADMIN_PASSWORD (sinon l'ancien bug B4 revient :
#     cookie ≠ secret attendu → boucle de redirection vers /admin/login),
#   • identique partout (dev local, preview, production Vercel).
#
# Génération (choisir UNE commande) :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex)')"
#   openssl rand -hex 32
# Exemple (NE PAS réutiliser tel quel) : 9f2c…a1 (64 caractères hex).
# Sans ce secret, /admin/* redirige vers /admin/login?error=config-missing
# (fallback anti-boucle) et les routes dev/test répondent HTTP 401.
ADMIN_SECRET_TOKEN=
